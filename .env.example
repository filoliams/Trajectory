# Copy this file to .env (in this same Trajectory folder) and fill in real values.
# .env is ignored by Git; this example file is safe to commit.

# Supabase: Project URL (Connect button) and secret key (Settings > API Keys)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=

# Claude API key (console.anthropic.com) - reads handwriting and analyses notes
ANTHROPIC_API_KEY=

# GoodNotes: the Auto Backup folder as synced to this PC, e.g.
#   OneDrive:      C:\Users\<you>\OneDrive\Goodnotes
#   Google Drive:  G:\My Drive\Goodnotes   (Google Drive for desktop)
GOODNOTES_DIR=

# Optional tuning (defaults shown)
# NOTES_AUTO_SYNC=1               # 0 = don't watch the folder while the server runs
# NOTES_POLL_SECONDS=300          # how often to check for new/changed notebooks
# NOTES_VISION_MODE=auto          # auto | always | never (always = read every page as an image)
# NOTES_TRANSCRIBE_MODEL=claude-sonnet-5-5
# NOTES_ANALYSIS_MODEL=claude-sonnet-5-5
# NOTES_USER_ID=                  # Supabase auth user id, once sign-in exists
