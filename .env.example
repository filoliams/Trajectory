# Copy this file to .env (in this same Trajectory folder) and fill in real values.
# .env is ignored by Git; this example file is safe to commit.

# Supabase: Project URL (Connect button) and secret key (Settings > API Keys)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=

# Phase 4: Anthropic API key for reading notes (console.anthropic.com > API Keys)
AI_API_KEY=
# Optional: which Claude model reads the pages
# AI_MODEL=claude-sonnet-5-5
